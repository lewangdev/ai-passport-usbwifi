# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"

# --- Flash(与 FoloToy AI Passport 基线一致)---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:关闭 ---
# USB-Serial-JTAG 是本固件的数据通道(PPP),任何控制台输出都会破坏 PPP 帧。
# 日志改为内存环形缓冲,经配置页 /api/log 查看。UART0 默认 TX=GPIO21 与背光冲突,也不可用。
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- 蓝牙:不需要,关闭以把 RAM 留给 Wi-Fi/lwIP ---
CONFIG_BT_ENABLED=n

# --- lwIP:PPP 服务端 + IP 转发 + NAT ---
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
# NAT 只支持 IPv4;关闭 IPV6CP,避免主机误以为有 IPv6 出口。
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=3
CONFIG_LWIP_LCP_MAXECHOFAILS=3
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# 转发场景下加大 TCP/UDP 资源与窗口。
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# --- HTTP 配置页 ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
